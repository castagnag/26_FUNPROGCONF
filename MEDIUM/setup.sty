% Customize exampleblock colors and fonts
\setbeamercolor{block title example}{fg=white,bg=cadmiumgreen}
\setbeamercolor{block body example}{fg=black,bg=cadmiumgreen!10}
\setbeamerfont{block title example}{size=\large,shape=\bf}

% Alternative exampleblock with different colors
\newenvironment<>{customexample}[1]{%
  \setbeamercolor{block title example}{fg=white,bg=darkgreen}%
  \setbeamercolor{block body example}{fg=black,bg=darkgreen!5}%
  \setbeamerfont{block title example}{size=\large,shape=\bf}%
  \begin{exampleblock}#2{#1}%
}{\end{exampleblock}}

% Code example block with special styling
\newenvironment<>{codeexample}[1]{%
  \setbeamercolor{block title example}{fg=white,bg=darkblue}%
  \setbeamercolor{block body example}{fg=black,bg=gray!5}%
  \setbeamerfont{block title example}{size=\large,shape=\bf}%
  \begin{exampleblock}#2{#1}%
}{\end{exampleblock}}

% Theorem-style example block
\newenvironment<>{theoremexample}[1]{%
  \setbeamercolor{block title example}{fg=white,bg=typePurple}%
  \setbeamercolor{block body example}{fg=black,bg=typePurple!8}%
  \setbeamerfont{block title example}{size=\large,shape=\bf}%
  \begin{exampleblock}#2{#1}%
}{\end{exampleblock}}

